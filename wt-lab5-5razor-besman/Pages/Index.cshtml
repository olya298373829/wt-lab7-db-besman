@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container py-5">
    <div class="p-5 mb-4 bg-white rounded-4 shadow-sm">
        <h1 class="display-5 fw-bold text-primary">Система управления счетами</h1>
        <p class="lead text-muted">Веб-приложение на ASP.NET Core Razor Pages для учёта банковских счетов.</p>
        <hr class="my-4">
        <a class="btn btn-primary btn-lg" asp-page="/BankAccounts/Index">
            Перейти к счетам
        </a>
    </div>
</div>