@page
@model wt_lab5_5razor_besman.Pages.BankAccounts.IndexModel
@{
    ViewData["Title"] = "Банковские счета";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог счетов</h1>
            <p class="text-muted">Всего счетов: @Model.Accounts.Count</p>
        </div>
        
        <!-- ПРОСТЫЕ ССЫЛКИ (для 1 балла) -->
        <div>
            <a href="/" class="btn btn-outline-secondary">Главная</a>
            <a href="/BankAccounts/Index" class="btn btn-outline-secondary">Счета</a>
            <a asp-page="/BankAccounts/Create" class="btn btn-success">Открыть новый счёт</a>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var acc in Model.Accounts)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4 border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary">ID: @acc.Id</span>
                            @if (acc.IsActive)
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Заблокирован</span>
                            }
                        </div>
                        
                        <h5 class="card-title fw-bold">@acc.Owner</h5>
                        <p class="text-muted mb-2">Счёт: @acc.AccountNumber</p>
                        
                        <p class="fs-4 fw-bold text-primary mt-auto mb-3">
                            @acc.Balance.ToString("F2") @acc.Currency
                        </p>
                        
                        <a asp-page="/BankAccounts/Details" asp-route-id="@acc.Id" class="btn btn-outline-primary">
                            Подробнее
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>